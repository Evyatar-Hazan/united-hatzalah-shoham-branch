{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["facebook", "instagram", "clarification", "visualFacts"],
  "properties": {
    "facebook": { "type": "string" },
    "instagram": { "type": "string" },
    "clarification": { "type": ["string", "null"] },
    "visualFacts": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    }
  }
}
