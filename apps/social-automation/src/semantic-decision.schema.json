{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "confidence", "reason", "question", "channels", "facebookText", "instagramText", "replaceImage", "resend", "controlAction"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["group_conversation", "create_post", "revise_draft", "approve_draft", "latest_draft", "cancel_draft", "system_control", "clarification"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string" },
    "question": { "type": ["string", "null"] },
    "channels": {
      "type": "array",
      "items": { "type": "string", "enum": ["facebook", "instagram"] }
    },
    "facebookText": { "type": ["string", "null"] },
    "instagramText": { "type": ["string", "null"] },
    "replaceImage": { "type": "boolean" },
    "resend": { "type": "boolean" },
    "controlAction": { "type": ["string", "null"], "enum": ["start", "stop", null] }
  }
}
